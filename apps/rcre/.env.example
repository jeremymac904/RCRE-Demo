# RCRE MVP — environment variable NAMES ONLY. Never commit real values.
# All of these are SERVER-ONLY. Nothing here may be prefixed NEXT_PUBLIC_.

# --- Database -------------------------------------------------------------
DATABASE_URL=

# --- Optional Follow Up Boss integration (server-only) --------------------
# RCRE CRM can operate independently. These are only needed to activate FUB.
# Basic auth: API key is the username, password blank.
FUB_API_KEY=
# Registered-system headers. Required for the higher rate-limit tier and for
# webhook registration. Obtained from apps.followupboss.com/system-registration
FUB_SYSTEM=
FUB_SYSTEM_KEY=
FUB_API_BASE_URL=https://api.followupboss.com/v1

# --- Runtime mode ---------------------------------------------------------
# production | development
# RCRE_DATA_MODE=fixtures is ONLY honoured when NODE_ENV !== 'production'.
RCRE_DATA_MODE=fixtures

# --- Safety gates (all default false / off) -------------------------------
RCRE_ALLOW_FUB_WRITES=false
RCRE_ALLOW_OUTBOUND_SEND=false

# --- MCP server -----------------------------------------------------------
RCRE_MCP_SHARED_SECRET=
